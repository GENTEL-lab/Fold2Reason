  "scope": "Qwen3.5 core data, training, structural readout, and General-10 evaluation",
  "changes": [
    "Reorganized modules by responsibility; rewrote internal imports to absolute fold2reason package imports.",
    "Removed sys.path injection and machine-specific paths; defaults resolve from the working directory.",
    "Updated display terminology to FoldingCorpus while preserving serialized tensor/checkpoint keys and training algorithms.",
    "Restricted the public text benchmark suite to seven General-10 text datasets; the other three use FTB and spatial evaluators.",
    "Changed text evaluation's per-dataset default cap from 1000 to 0 (full dataset).",
    "Added a lightweight CLI, TOML recipes, normalized three-seed aggregation, synthetic examples, docs, and CPU tests."
  ],
  "excluded": [
    "Credentials and shell profiles",
    "Private cluster launchers and machine-specific orchestration",
    "Model weights, training/benchmark datasets, caches, and experiment outputs",
    "Manuscript archives, proprietary fonts, and API experiment scripts",
    "Exploratory and model-specific experiment drivers outside the documented Qwen core"
